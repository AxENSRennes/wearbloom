NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wearbloom:wearbloom@localhost:5432/wearbloom
POSTGRES_PASSWORD=replace-me
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=https://wearbloom.app
STORAGE_ROOT=./data/private
AI_PROVIDER=stub
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1536
PROMPT_VERSION=wearbloom-v1
IMAGE_COST_MICROS=0
MAX_ASSETS_PER_OWNER=500
FREE_RENDER_ALLOWANCE=2
PAID_MONTHLY_ALLOWANCE=20
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_BASE64=
APPLE_APP_BUNDLE_IDENTIFIER=com.axel.wearbloom
APPLE_APP_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_BASE64=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_BASE64=
APNS_TOPIC=com.axel.wearbloom
APNS_ENVIRONMENT=sandbox
SENTRY_DSN_SERVER=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Require valid App Attest assertions for uploads and renders in staging/production.
APP_ATTEST_REQUIRED=false
APP_ATTEST_ALLOW_DEVELOPMENT=true
