# Local infrastructure access. Never commit real values.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_REDACT_ENV=true

# The SSH alias is preferred; host/user/key fields support non-interactive scripts.
VPS_SSH_ALIAS=prospection-vps
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_SSH_KEY_PATH=

# Sentry client ingestion. The DSN is safe to embed in the iOS app, but keep environment-specific values configurable.
SENTRY_DSN_IOS=
SENTRY_ORG=monbonami
SENTRY_PROJECT_IOS=apple-ios

# PostHog EU Cloud (the project token is public and safe to embed in the iOS app)
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=228098

# Sentry organization token with org:ci scope (CI only; never embed in the app)
SENTRY_AUTH_TOKEN=
