                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "enum": [
                        "top",
                        "bottom",
                        "dress",
                        "outerwear"
                      ]
                    },
                    "confidence": {
                      "type": "number"
                    },
                    "requiresConfirmation": {
                      "type": "boolean"
                    },
                    "model": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "category",
                    "confidence",
                    "requiresConfirmation",
                    "model"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request integrity rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Asset not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid business input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/garments/{id}": {
      "put": {
        "operationId": "upsertGarment",
        "tags": [
          "Garments"
        ],
