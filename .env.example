# Local infrastructure access. Never commit real values.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_REDACT_ENV=true

# The SSH alias is preferred; host/user/key fields support non-interactive scripts.
VPS_SSH_ALIAS=prospection-vps
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_SSH_KEY_PATH=

# Sentry client ingestion. The DSN is safe to embed in the iOS app, but keep environment-specific values configurable.
SENTRY_DSN_IOS=
SENTRY_ORG=monbonami
SENTRY_PROJECT_IOS=apple-ios

# PostHog EU Cloud (the project token is public and safe to embed in the iOS app)
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=228098

# Sentry organization token with org:ci scope (CI only; never embed in the app)
SENTRY_AUTH_TOKEN=

# Image generation. Configure exactly one launch provider.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Apple server integrations. Private .p8 files are base64-encoded before being stored in Dokploy or CI.
APPLE_TEAM_ID=DMLL8HQFCU
APPLE_CLIENT_ID=com.axel.wearbloom
APPLE_APP_BUNDLE_IDENTIFIER=com.axel.wearbloom
APPLE_APP_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY_BASE64=
# Optional local-development alternative to the base64 value above. Never use a repository path.
APPLE_SIGN_IN_PRIVATE_KEY_PATH=
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_PRIVATE_KEY_BASE64=
APNS_SANDBOX_PRIVATE_KEY_PATH=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_PRIVATE_KEY_BASE64=
APNS_PRODUCTION_PRIVATE_KEY_PATH=
APNS_TOPIC=com.axel.wearbloom

# App Store Server API. Create this key under App Store Connect > Users and Access
# > Integrations > In-App Purchase. It is separate from Sign in with Apple.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=

# App Store Connect API automation. This is a separate App Manager key used by
# local release tooling; keep the .p8 file outside the repository.
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY_PATH=

# Separate Sentry project for the Bun API and worker.
SENTRY_DSN_SERVER=
SENTRY_PROJECT_SERVER=
