    "/v1/looks/{id}": {
      "put": {
        "operationId": "upsertLook",
        "tags": [
          "Looks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 1000,
                    "default": ""
                  },
                  "garments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "category": {
                          "type": "string",
