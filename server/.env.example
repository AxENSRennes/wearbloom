NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wearbloom:wearbloom@localhost:5432/wearbloom
POSTGRES_PASSWORD=replace-me
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=https://wearbloom.app
STORAGE_ROOT=./data/private
AI_PROVIDER=stub
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1536
PROMPT_VERSION=wearbloom-v1
FREE_RENDER_ALLOWANCE=2
PAID_MONTHLY_ALLOWANCE=20
REVENUECAT_WEBHOOK_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
