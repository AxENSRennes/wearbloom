{
  "name": "wearbloom-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "ROLE=worker bun src/worker.ts",
    "openapi": "bun scripts/export-openapi.ts",
    "format:check": "biome format src tests scripts",
    "lint": "biome lint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "auth:schema:generate": "bunx @better-auth/cli@1.4.21 generate --config scripts/auth-cli.ts --output src/db/auth-schema.generated.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@hono/zod-openapi": "1.5.1",
    "@sentry/bun": "^10.67.0",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "jose": "6.2.3",
    "node-app-attest": "1.0.1",
    "openai": "6.48.0",
    "postgres": "3.4.9",
    "posthog-node": "^5.46.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
